{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato",
    "mode": "system"
  },
  "animations": true,
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "mouse": true,
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "prompt"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1,
    "sound_pack": "opencode.default"
  },
  "leader": {
    "timeout": 2000
  },
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true,
    "timing": true
  },
  "prompt": {
    "image_preview": true
  },
  "experimental": {
    "new-designs": false,
    "client-mcp": false
  }
}
