{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
    "bruno-mcp": {
      "type": "local",
      "command": ["node", "C:\\Users\\willo\\.config\\opencode\\bruno-mcp-launcher.mjs"],
      "enabled": true,
      "environment": {
        "BRUNO_SSRF_ALLOWLIST": "localhost,127.0.0.1"
      },
    },
  },
}
