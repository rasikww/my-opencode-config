{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/skills/clear-writing/SKILL.md"],
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000,
          },
        },
      },
    },
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
    },
    "bruno-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\willo\\.config\\opencode\\bruno-mcp-launcher.mjs",
      ],
      "enabled": true,
      "environment": {
        "BRUNO_SSRF_ALLOWLIST": "localhost,127.0.0.1",
      },
    },
    "codebase-memory": {
      "type": "local",
      "command": ["C:\\Users\\willo\\.local\\bin\\codebase-memory-mcp.exe"],
      "enabled": true,
    },
  },
}
